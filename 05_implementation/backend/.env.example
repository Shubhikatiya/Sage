# Sage LLM Configuration
# Add your API key for the provider you want to use

# Groq (Recommended - fastest, no data training)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (Claude)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI
# Get key at: https://platform.openai.com/
OPENAI_API_KEY=

# Moonshot (Kimi)
# Get key at: https://platform.moonshot.cn/
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.6

# Ollama (Local or Remote endpoint)
# - For local Ollama: OLLAMA_BASE_URL=http://localhost:11434
# - For remote tunnel: OLLAMA_BASE_URL=http://your-tunnel-url
# - No API key needed for Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=minimax

# Provider priority: groq > anthropic > openai > moonshot > ollama
LLM_PROVIDER=groq
